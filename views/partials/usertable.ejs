<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Nome</th>
      <th>Email</th>
      <th>Celular</th>
    </tr>
  </thead>
  <tbody>
    <% for(let i= 0; i<9;i++) { %>
    <tr>
      <td><%= i %></td>
      <td>NOME</td>
      <td>EMAIL</td>
      <td>CELULAR</td>
    </tr>
    <% } %>
  </tbody>
</table>
